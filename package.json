{
  "name": "codebase-learning-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "description": "A desktop learning environment that turns codebases into guided, versioned courses.",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:electron": "node tests/electron-smoke.mjs",
    "lint": "eslint .",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-exclude='src/**' --test-coverage-lines=95 --test-coverage-branches=75 --test-coverage-functions=92 tests/*.test.mjs",
    "test:components": "node tests/component-smoke.mjs",
    "preflight": "node scripts/preflight.mjs",
    "test:portable": "node tests/electron-portable.mjs",
    "ci": "npm run lint && npm run build && npm run coverage && npm run test:components && npm run test:ui && npm run test:portable"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "monaco-editor": "0.56.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "cross-env": "10.0.0",
    "electron": "43.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "1.62.1",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.67.0",
    "vite": "8.2.1",
    "wait-on": "8.0.4"
  },
  "overrides": {
    "dompurify": "3.4.13"
  }
}
